{
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "mqtt": "5.16.0",
    "three": "0.186.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "happy-dom": "21.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "name": "pakachi-sm",
  "version": "0.41.0",
  "private": true,
  "type": "module",
  "description": "PaKaChi StateMaschine \u2013 lokaler Avatar-Player und integriertes Studio",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "test:e2e": "playwright test",
    "generate:avatars": "node scripts/generate-avatars.mjs",
    "test:legacy": "node public/legacy/pakachi/tests/controller.cjs && node public/legacy/pakachi/tests/lifecycle.cjs",
    "mcp": "python server/python/pakachi_mcp.py",
    "mcp:legacy": "node server/mcp.mjs",
    "test:python": "node --test tests/integration/*.test.ts",
    "generate:model": "node scripts/generate-model.mjs",
    "setup:ollama": "node scripts/setup-ollama.mjs",
    "serve:generator": "node server/generation.mjs",
    "export:zoo": "node scripts/export-zoo.mjs",
    "merge:zoo": "node scripts/merge-zoo.mjs",
    "export:moves": "node scripts/export-moves.mjs",
    "merge:moves": "node scripts/merge-moves.mjs"
  }
}
